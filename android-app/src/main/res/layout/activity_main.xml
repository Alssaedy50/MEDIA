<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F7F9FC">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MEDIA"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#14213D"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Medical Education AI • Offline Alpha"
        android:textSize="15sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="● OFFLINE"
        android:textStyle="bold"
        android:padding="8dp"
        android:background="#E8F5E9"/>

    <EditText
        android:id="@+id/question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ask a medical question…"
        android:inputType="textCapSentences|textMultiLine"
        android:minHeight="56dp"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/ask_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ASK MEDIA OFFLINE"
        android:layout_marginTop="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp">
        <TextView
            android:id="@+id/answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your answer will appear here.\n\nNo Internet connection is required for this Alpha."
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:background="#FFFFFF"/>
    </ScrollView>
</LinearLayout>