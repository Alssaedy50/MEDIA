<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="24dp">

        <!-- Header: medical vector logo + title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="MEDIA medical logo"
                android:src="@drawable/ic_media_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MEDIA"
                    android:textColor="#0D2035"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medical Education AI"
                    android:textColor="#52606D"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALPHA"
                android:textColor="#0B6B55"
                android:textStyle="bold"
                android:textSize="12sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:background="#DDF4EC"/>
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="● OFFLINE  •  Loading local medical library..."
            android:textColor="#0B6B55"
            android:textStyle="bold"
            android:textSize="13sp"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            android:background="#E6F6F0"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اسأل سؤالاً طبياً · Ask a question"
            android:textColor="#0D2035"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ابحث في مكتبة أمراض الدم المضمّنة، أو أدخل اختصاراً طبياً مثل CBC أو EPO أو IDA.\nSearch the bundled Hematology library. MEDIA answers only when local evidence is sufficiently matched."
            android:textColor="#52606D"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="58dp"
            android:hint="مثال: اشرح تكون الكريات الحمراء · e.g. Explain erythropoiesis"
            android:textColor="#0F172A"
            android:textColorHint="#64748B"
            android:textSize="16sp"
            android:inputType="textCapSentences|textMultiLine"
            android:imeOptions="actionSearch"
            android:maxLines="4"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:elevation="4dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/bg_input"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/ask_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="ASK MEDIA · اسأل"
                android:textStyle="bold"
                android:textSize="14sp"
                android:backgroundTint="#0B6B55"
                android:textColor="#FFFFFF"
                android:contentDescription="Ask MEDIA a medical question"/>

            <Button
                android:id="@+id/clear_button"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:text="CLEAR"
                android:textSize="13sp"
                android:layout_marginStart="8dp"
                android:contentDescription="Clear the current question and answer"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="أسئلة سريعة · QUICK START"
            android:textColor="#52606D"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <!-- Quick-start chips scroll horizontally so labels never wrap -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_bone_marrow"
                    style="@style/Widget.MEDIA.Chip"
                    android:text="Bone marrow"
                    android:contentDescription="Ask about bone marrow"/>

                <TextView
                    android:id="@+id/chip_erythropoiesis"
                    style="@style/Widget.MEDIA.Chip"
                    android:text="Erythropoiesis"
                    android:contentDescription="Ask about erythropoiesis"/>

                <TextView
                    android:id="@+id/chip_ida"
                    style="@style/Widget.MEDIA.Chip"
                    android:text="Iron deficiency anemia (IDA)"
                    android:contentDescription="Ask about iron deficiency anemia"/>

                <TextView
                    android:id="@+id/chip_cbc"
                    style="@style/Widget.MEDIA.Chip"
                    android:text="CBC"
                    android:contentDescription="Ask about complete blood count"/>

                <TextView
                    android:id="@+id/chip_epo"
                    style="@style/Widget.MEDIA.Chip"
                    android:text="EPO"
                    android:contentDescription="Ask about erythropoietin"/>

                <TextView
                    android:id="@+id/chip_sickle"
                    style="@style/Widget.MEDIA.Chip"
                    android:text="Sickle cell disease"
                    android:contentDescription="Ask about sickle cell disease"/>
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="الإجابة · ANSWER"
                android:textColor="#0D2035"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/copy_button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="COPY"
                android:textSize="12sp"
                android:visibility="gone"
                android:contentDescription="Copy the current MEDIA answer"/>
        </LinearLayout>

        <!-- Answer card: elevated, readable medical typography, long-press selection enabled -->
        <TextView
            android:id="@+id/answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ستظهر الإجابة هنا.\nYour answer will appear here.\n\nNo Internet connection is required for the current Alpha."
            android:textColor="#1E293B"
            android:textSize="15sp"
            android:lineSpacingExtra="6dp"
            android:textIsSelectable="true"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:elevation="4dp"
            android:padding="18dp"
            android:background="@drawable/bg_answer"/>

        <TextView
            android:id="@+id/scope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="نطاق المعرفة: أمراض الدم • loading..."
            android:textColor="#71808C"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</ScrollView>
