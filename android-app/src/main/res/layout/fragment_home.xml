<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/space_2xl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_lg">

        <!-- ===================== Wordmark ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_media_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_md"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.MEDIA.Display" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_tagline"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="@dimen/text_caption"
                    android:layout_marginTop="1dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===================== Greeting ===================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3xl"
            android:text="@string/home_greeting"
            android:textColor="@color/md_primary"
            android:textSize="@dimen/text_label"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/home_headline"
            android:textAppearance="@style/TextAppearance.MEDIA.TitleLarge"
            android:lineSpacingExtra="@dimen/line_spacing_dense" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/home_subheadline"
            android:textAppearance="@style/TextAppearance.MEDIA.BodyMuted" />

        <!-- ===================== Question input ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:orientation="vertical"
            android:background="@drawable/bg_input_field"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_md"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm">

            <EditText
                android:id="@+id/home_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:background="@null"
                android:hint="@string/home_input_hint"
                android:textColor="@color/md_on_background"
                android:textColorHint="@color/md_on_surface_variant"
                android:textSize="@dimen/text_body_lg"
                android:inputType="textCapSentences|textMultiLine"
                android:imeOptions="actionSend"
                android:maxLines="5"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:importantForAutofill="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/home_library_hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/status_offline_short"
                    android:textColor="@color/md_on_surface_muted"
                    android:textSize="@dimen/text_caption" />

                <ImageButton
                    android:id="@+id/home_mic"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="10dp"
                    android:contentDescription="@string/home_mic"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/md_on_surface_variant" />

                <ImageButton
                    android:id="@+id/home_send"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:background="@drawable/bg_send_button"
                    android:padding="11dp"
                    android:contentDescription="@string/home_send"
                    android:src="@drawable/ic_send"
                    app:tint="@color/md_on_primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===================== Quick actions ===================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:text="@string/home_quick_actions"
            android:textAppearance="@style/TextAppearance.MEDIA.Label" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:scrollbars="none"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/quick_explain"
                    style="@style/Widget.MEDIA.Chip"
                    android:text="@string/action_explain" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/quick_case"
                    style="@style/Widget.MEDIA.Chip"
                    android:text="@string/action_clinical_case" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/quick_study"
                    style="@style/Widget.MEDIA.Chip"
                    android:text="@string/action_study" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/quick_term"
                    style="@style/Widget.MEDIA.Chip"
                    android:text="@string/action_term" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/quick_summarize"
                    style="@style/Widget.MEDIA.Chip"
                    android:text="@string/action_summarize" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ===================== Recent questions ===================== -->
        <LinearLayout
            android:id="@+id/recent_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3xl"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_recent"
                android:textAppearance="@style/TextAppearance.MEDIA.Label" />

            <TextView
                android:id="@+id/recent_view_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_view_all"
                android:textColor="@color/md_primary"
                android:textSize="@dimen/text_label"
                android:padding="@dimen/space_sm"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>

        <TextView
            android:id="@+id/recent_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/home_recent_empty"
            android:textAppearance="@style/TextAppearance.MEDIA.Caption" />

        <LinearLayout
            android:id="@+id/recent_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="vertical" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
