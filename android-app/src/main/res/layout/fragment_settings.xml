<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/space_3xl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_lg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textAppearance="@style/TextAppearance.MEDIA.TitleLarge" />

        <!-- ===================== Model Manager ===================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:text="@string/settings_section_model"
            android:textAppearance="@style/TextAppearance.MEDIA.Label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginTop="@dimen/space_sm"
            android:padding="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/model_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_model"
                    app:tint="@color/md_on_surface_variant" />

                <TextView
                    android:id="@+id/model_status_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:text="@string/settings_model_not_installed"
                    android:textAppearance="@style/TextAppearance.MEDIA.Subtitle" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_thickness"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_md"
                android:background="@color/md_divider" />

            <LinearLayout
                android:id="@+id/model_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            android:id="@+id/model_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/settings_model_note"
            android:textAppearance="@style/TextAppearance.MEDIA.Caption" />

        <LinearLayout
            android:id="@+id/engines_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/space_sm" />

        <!-- ===================== Language ===================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3xl"
            android:text="@string/settings_section_language"
            android:textAppearance="@style/TextAppearance.MEDIA.Label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginTop="@dimen/space_sm"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/settings_bilingual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/settings_bilingual"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/text_body_lg" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_bilingual_note"
                android:textAppearance="@style/TextAppearance.MEDIA.Caption" />
        </LinearLayout>

        <!-- ===================== Appearance ===================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3xl"
            android:text="@string/settings_section_appearance"
            android:textAppearance="@style/TextAppearance.MEDIA.Label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginTop="@dimen/space_sm"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_sm"
                android:text="@string/settings_theme"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/text_body_lg" />

            <RadioGroup
                android:id="@+id/settings_theme_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/theme_system"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/settings_theme_system"
                    android:textColor="@color/md_on_surface" />

                <RadioButton
                    android:id="@+id/theme_light"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/settings_theme_light"
                    android:textColor="@color/md_on_surface" />

                <RadioButton
                    android:id="@+id/theme_dark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/settings_theme_dark"
                    android:textColor="@color/md_on_surface" />
            </RadioGroup>
        </LinearLayout>

        <!-- ===================== About ===================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3xl"
            android:text="@string/settings_section_about"
            android:textAppearance="@style/TextAppearance.MEDIA.Label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginTop="@dimen/space_sm"
            android:padding="@dimen/space_lg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_about_body"
                android:textAppearance="@style/TextAppearance.MEDIA.BodyMuted" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_thickness"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_md"
                android:background="@color/md_divider" />

            <LinearLayout
                android:id="@+id/about_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
