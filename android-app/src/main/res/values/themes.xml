<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      MEDIA application theme.

      Material 3 DayNight so light/dark follow the device (and the user's explicit override set
      by AppCompatDelegate in Settings). All colours resolve through the design-system tokens,
      therefore the same theme produces a correct light and dark appearance.
    -->
    <style name="Theme.MEDIA" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>

        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>

        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>

        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_divider</item>

        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>

        <item name="android:statusBarColor">@color/md_background</item>
        <item name="android:navigationBarColor">@color/md_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/md_background</item>
        <item name="android:colorAccent">@color/md_primary</item>
        <item name="android:textColorPrimary">@color/md_on_background</item>
        <item name="android:textColorSecondary">@color/md_on_surface_variant</item>

        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MEDIA.Dialog</item>
    </style>

    <style name="ThemeOverlay.MEDIA.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
    </style>

    <!-- ============================ TYPOGRAPHY ============================ -->
    <style name="TextAppearance.MEDIA.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/md_on_background</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.MEDIA.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title_lg</item>
        <item name="android:textColor">@color/md_on_background</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.MEDIA.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/md_on_background</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.MEDIA.Subtitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">@dimen/text_title_sm</item>
        <item name="android:textColor">@color/md_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.MEDIA.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/md_on_surface</item>
        <item name="android:lineSpacingExtra">@dimen/line_spacing_body</item>
    </style>

    <style name="TextAppearance.MEDIA.BodyMuted" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/md_on_surface_variant</item>
        <item name="android:lineSpacingExtra">@dimen/line_spacing_dense</item>
    </style>

    <style name="TextAppearance.MEDIA.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/md_on_surface_variant</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="TextAppearance.MEDIA.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/md_on_surface_muted</item>
    </style>

    <!-- ============================ BUTTONS ============================ -->
    <style name="Widget.MEDIA.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="backgroundTint">@color/md_primary</item>
        <item name="android:textColor">@color/md_on_primary</item>
        <item name="cornerRadius">@dimen/radius_md</item>
    </style>

    <style name="Widget.MEDIA.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="backgroundTint">@color/md_primary_container</item>
        <item name="android:textColor">@color/md_on_primary_container</item>
        <item name="cornerRadius">@dimen/radius_md</item>
    </style>

    <style name="Widget.MEDIA.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/md_primary</item>
    </style>

    <!-- ============================ CARDS ============================ -->
    <style name="Widget.MEDIA.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/md_surface_raised</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="contentPadding">@dimen/space_lg</item>
    </style>

    <style name="Widget.MEDIA.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/md_surface_raised</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="strokeColor">@color/md_outline</item>
        <item name="contentPadding">@dimen/space_lg</item>
    </style>

    <!-- ============================ CHIPS ============================ -->
    <style name="Widget.MEDIA.Chip" parent="Widget.Material3.Chip.Suggestion">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">@dimen/space_sm</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="chipBackgroundColor">@color/md_primary_container</item>
        <item name="android:textColor">@color/md_on_primary_container</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Widget.MEDIA.Chip.Action" parent="Widget.Material3.Chip.Assist">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="chipBackgroundColor">@color/md_surface_variant</item>
        <item name="android:textColor">@color/md_on_surface</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- ============================ TEXT FIELDS ============================ -->
    <style name="Widget.MEDIA.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_lg</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_lg</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_lg</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_lg</item>
        <item name="boxStrokeColor">@color/md_primary</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="hintTextColor">@color/md_on_surface_variant</item>
        <item name="android:textColorHint">@color/md_on_surface_variant</item>
    </style>

    <!-- ============================ NAVIGATION ============================ -->
    <style name="Widget.MEDIA.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/md_surface</item>
        <item name="itemIconTint">@color/md_bottom_nav_tint</item>
        <item name="itemTextColor">@color/md_bottom_nav_tint</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.MEDIA.NavIndicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">8dp</item>
    </style>

    <style name="Widget.MEDIA.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/md_primary_container</item>
    </style>

    <!-- ============================ TOOLBAR ============================ -->
    <style name="Widget.MEDIA.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/md_background</item>
        <item name="titleTextColor">@color/md_on_background</item>
        <item name="titleTextAppearance">@style/TextAppearance.MEDIA.Title</item>
    </style>

    <!-- Compact icon button used on the answer action row. -->
    <style name="Widget.MEDIA.MessageAction" parent="">
        <item name="android:layout_width">@dimen/icon_button_size</item>
        <item name="android:layout_height">@dimen/icon_button_size</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/md_on_surface_variant</item>
    </style>

</resources>
