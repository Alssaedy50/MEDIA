<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MEDIA" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#07111F</item>
        <item name="android:navigationBarColor">#07111F</item>
        <item name="android:colorAccent">#7BD4C0</item>
    </style>
    <style name="TextAppearance.MEDIA.Error" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">#E8EEF7</item>
    </style>

    <!-- Horizontally scrollable quick-start chip. -->
    <style name="Widget.MEDIA.Chip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">#0B4F42</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
